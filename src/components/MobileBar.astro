---
import business from '../data/business.json';
---
<nav class="mobile-bar" aria-label="Quick actions">
  <a href="/menu" data-track="menu_view" data-track-location="mobile_bar">Menu</a>
  <a href={business.links.reserve} class="is-primary" data-track="reserve_click" data-track-location="mobile_bar">Reserve</a>
  <a href={business.links.order} data-track="order_click" data-track-location="mobile_bar">Order</a>
</nav>
<style>
  .mobile-bar { display: none; }
  @media (max-width: 767px) {
    .mobile-bar {
      position: fixed; inset: auto 0 0; z-index: 40; display: grid; grid-template-columns: 1fr 1.2fr 1fr;
      background: var(--espresso); border-top: var(--hair) solid rgba(184,154,102,.45);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .mobile-bar a {
      display: grid; place-items: center; min-height: 3.5rem; color: var(--ivory-on-night); text-decoration: none;
      font-family: var(--font-sans); font-weight: 600; font-size: var(--fs-ui); letter-spacing: var(--track-ui); text-transform: uppercase;
    }
    .mobile-bar a + a { border-left: var(--hair) solid rgba(184,154,102,.3); }
    .mobile-bar .is-primary { background: var(--gold); color: var(--espresso); }
  }
</style>
