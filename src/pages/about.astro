---
// Copy taken from the live poloslounge.com Welcome section (13 Oct 2026). "Fine Dining" card omitted per the approved proposal.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Wordmark from '../components/Wordmark.astro';
import business from '../data/business.json';
import { breadcrumbJsonLd } from '../lib/menu';
import pink from '../assets/photos/pink-martini.jpg';
import seafood from '../assets/photos/seafood-pasta.jpg';
import napkin from '../assets/photos/polos-napkin-cocktail.jpg';
const b = business;
const jsonLd = [breadcrumbJsonLd([{ name: 'Home', url: `${b.url}/` }, { name: 'About', url: `${b.url}/about` }])];
---
<Base title="About Polos Social Lounge | Sherwood Park" description="Polos Social Lounge is a restaurant and cocktail lounge on Emerald Drive in Sherwood Park for date nights, after-work drinks and group dining." jsonLd={jsonLd}>
  <header class="page-hero container">
    <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">About</li></ol></nav>
    <p class="eyebrow">Welcome</p>
    <h1 class="h1 about-h1">Sherwood Park's Favourite Spot to Eat, Drink & Connect</h1>
  </header>

  <section class="container about-grid">
    <div class="about-copy">
      <p class="lede" data-reveal>From brunch to late-night bites, every dish at Polos is crafted to impress. We bring together bold flavours, a refined atmosphere, and warm hospitality — come for the food, stay for the vibe.</p>
      <p data-reveal style="--i:1">Your restaurant and cocktail lounge in Sherwood Park for date nights, after-work drinks and group dining. Join us from across Strathcona County and East Edmonton.</p>
      <div class="btn-row" data-reveal style="--i:2">
        <a class="btn btn--primary" href={b.links.reserve} data-track="reserve_click" data-track-location="about">Make a Reservation</a>
        <a class="btn btn--secondary" href="/menu">View Menu</a>
      </div>
    </div>
    <figure class="frame about-img" data-reveal="mask"><Photo src={pink} alt="A pink cocktail in the sunlit POLOS dining room" sizes="(min-width: 900px) 34vw, 86vw" /></figure>
  </section>

  <section class="container features" aria-label="What we do">
    <article data-reveal>
      <h2 class="section-title">Craft Cocktails</h2>
      <p>An inspired bar program featuring classic and creative cocktails for every occasion.</p>
      <a class="text-link" href="/menu/drinks">Drink menu <span class="arrow" aria-hidden="true">→</span></a>
    </article>
    <article data-reveal style="--i:1">
      <h2 class="section-title">Private Events</h2>
      <p>Elegant banquet space and full-service catering for birthdays, corporate events & more.</p>
      <a class="text-link" href="/private-events">Private events <span class="arrow" aria-hidden="true">→</span></a>
    </article>
    <article data-reveal style="--i:2">
      <h2 class="section-title">Happy Hour</h2>
      <p>{b.happyHour.lines.map((l) => `${l.label} ${l.text}`).join(' · ')}.</p>
      <a class="text-link" href="/happy-hour">Happy Hour <span class="arrow" aria-hidden="true">→</span></a>
    </article>
  </section>

  <section class="theme-night visiting" data-theme="night">
    <div class="container visiting-grid">
      <div class="v-imgs">
        <figure data-reveal="mask"><Photo src={seafood} alt="Seafood pasta with mussels and garlic bread" sizes="(min-width: 900px) 22vw, 45vw" /></figure>
        <figure data-reveal="mask" style="--i:1"><Photo src={napkin} alt="A cocktail beside a POLOS napkin" sizes="(min-width: 900px) 22vw, 45vw" /></figure>
      </div>
      <div class="v-copy">
        <p class="eyebrow">Visiting Sherwood Park</p>
        <h2 class="h2">Dinner & Cocktails Near Your Sherwood Park Hotel</h2>
        <p>{b.hotelNote}</p>
        <p>Whether you are here for work or a weekend away, join us for dinner, cocktails or happy hour. Planning a meal with colleagues or friends? Explore our group dining and private event options.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={b.links.reserve} data-track="reserve_click" data-track-location="about_hotel">Reserve a Table</a>
          <a class="btn btn--secondary" href="/contact">Find Us</a>
        </div>
      </div>
    </div>
    <div class="container about-mark" aria-hidden="true"><Wordmark decorative variant="lockup" /></div>
  </section>
</Base>
<style>
  .about-h1 { font-size: var(--fs-h1) !important; max-width: 20ch; }
  .about-grid { display: grid; gap: var(--s-8); align-items: center; padding-bottom: var(--s-9); }
  @media (min-width: 900px) { .about-grid { grid-template-columns: 1.1fr 0.9fr; } }
  .about-copy { display: grid; gap: var(--s-5); }
  .about-img { aspect-ratio: 4 / 5; max-width: 26rem; justify-self: center; margin: var(--s-3); }
  .features { display: grid; gap: var(--s-7) var(--gutter); grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); padding-bottom: var(--s-9); }
  .features article { display: grid; gap: var(--s-3); align-content: start; border-top: 1px solid var(--gold); padding-top: var(--s-5); }
  .visiting { padding-block: var(--section-pad); }
  .visiting-grid { display: grid; gap: var(--s-8); align-items: center; }
  @media (min-width: 900px) { .visiting-grid { grid-template-columns: 1fr 1fr; } }
  .v-imgs { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .v-imgs figure { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
  .v-imgs figure:nth-child(2) { margin-top: var(--s-8); }
  .v-imgs :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .v-copy { display: grid; gap: var(--s-4); justify-items: start; }
  .about-mark { color: var(--logo-gold); width: min(18rem, 60vw); margin-top: var(--s-10); opacity: .9; }
</style>
