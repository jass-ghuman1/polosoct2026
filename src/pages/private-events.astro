---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import business from '../data/business.json';
import ev from '../data/events.json';
import { breadcrumbJsonLd } from '../lib/menu';
import napkin from '../assets/photos/polos-napkin-cocktail.jpg';
import wineHand from '../assets/photos/red-wine-in-hand.jpg';
import wings from '../assets/photos/wings.jpg';
const b = business;
const occasions = ['Corporate events', 'Christmas parties', 'Birthdays & celebrations', 'Business dinners', 'Group dining'];
const jsonLd = [breadcrumbJsonLd([{ name: 'Home', url: `${b.url}/` }, { name: 'Private Events', url: `${b.url}/private-events` }])];
---
<Base title="Private Events & Banquets in Sherwood Park | Polos Social Lounge" description="Corporate events, Christmas parties, birthdays and group dining at Polos Social Lounge in Sherwood Park. Banquet packages from $30 per person, full bar service with 16 beers on tap." jsonLd={jsonLd}>
  <div class="theme-night" data-theme="night">
    <header class="page-hero container">
      <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Private Events</li></ol></nav>
      <p class="eyebrow">Private events & banquets · Sherwood Park</p>
      <h1 class="h1">{ev.title}</h1>
      <p class="lede">{ev.intro}</p>
      <ul class="occasions">{occasions.map((o) => <li>{o}</li>)}</ul>
      <div class="btn-row">
        <a class="btn btn--primary" href={b.links.eventLead} data-track="event_enquiry_open" data-track-location="events_hero">Plan Your Event</a>
        <a class="btn btn--secondary" href={`tel:${b.phone.tel}`} data-track="phone_click" data-track-location="events_hero">Call {b.phone.display}</a>
      </div>
    </header>

    <div class="container ev-photos">
      <figure class="frame" data-reveal="mask"><Photo src={napkin} alt="A cocktail beside a POLOS napkin" sizes="(min-width: 900px) 30vw, 45vw" /></figure>
      <figure data-reveal="mask" style="--i:1"><Photo src={wineHand} alt="A guest holding a glass of red wine against the brick wall" sizes="(min-width: 900px) 30vw, 45vw" /></figure>
      <figure data-reveal="mask" style="--i:2"><Photo src={wings} alt="Chicken wings with carrot and celery sticks and dip" sizes="(min-width: 900px) 30vw, 45vw" /></figure>
    </div>

    <section class="container packages" aria-labelledby="pk-h">
      <h2 id="pk-h" class="rule-title section-title" style="color: var(--gold)"><span>Banquet packages</span></h2>
      <ul class="pk-grid">
        {ev.packages.map((p, i) => (
          <li class="pk" data-reveal style={`--i:${i % 3}`}>
            <div class="pk-head"><h3 class="pk-name">{p.name}</h3><p class="pk-price">${p.price}<span>/{p.unit}</span></p></div>
            <p class="pk-desc">{p.description}</p>
            {p.choices?.map((c) => <p class="pk-choice"><span>{c.label}:</span> {c.options}</p>)}
          </li>
        ))}
      </ul>
    </section>

    <section class="container ev-info">
      <div class="ev-card">
        <h2 class="section-title gold">{ev.bar.title}</h2>
        <p>{ev.bar.text}</p>
        <p class="muted">{ev.bar.note}</p>
      </div>
      <div class="ev-card">
        <h2 class="section-title gold">Booking</h2>
        <p>{ev.booking_fee}</p>
      </div>
      <p class="muted ev-allergy">{ev.allergy}</p>
    </section>

    <section class="container ev-cta">
      <div class="double-rule" aria-hidden="true"></div>
      <h2 class="h2">Bring people <em>together.</em></h2>
      <div class="btn-row">
        <a class="btn btn--primary" href={b.links.eventLead} data-track="event_enquiry_open" data-track-location="events_footer">Plan Your Event</a>
        <a class="btn btn--secondary" href="/menu">See Our Menus</a>
      </div>
    </section>
  </div>
</Base>
<style>
  .theme-night { padding-bottom: var(--section-pad); overflow-x: clip; }
  .occasions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2); }
  .occasions li { border: 1px solid rgba(184,154,102,.45); padding: 0.5rem 0.9rem 0.35rem; font-family: var(--font-sans); font-weight: 600; font-size: 0.72rem; letter-spacing: var(--track-ui); text-transform: uppercase; }
  .ev-photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); margin-block: var(--s-6) var(--s-9); }
  .ev-photos figure { margin: 0; aspect-ratio: 4 / 5; overflow: visible; }
  .ev-photos figure:nth-child(2) { margin-top: var(--s-8); }
  .ev-photos :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 599px) { .ev-photos { grid-template-columns: 1fr 1fr; } .ev-photos figure:nth-child(3) { display: none; } }
  .packages { display: grid; gap: var(--s-7); }
  .pk-grid { display: grid; gap: var(--gutter); grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); }
  .pk { border: 1px solid rgba(184,154,102,.35); padding: var(--s-6) var(--s-5); display: grid; gap: var(--s-3); align-content: start; }
  .pk-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); border-bottom: 1px solid rgba(184,154,102,.25); padding-bottom: var(--s-3); }
  .pk-name { font-family: var(--font-sans); font-weight: 600; font-size: 0.95rem; letter-spacing: var(--track-item); text-transform: uppercase; }
  .pk-price { font-size: 1.6rem; color: var(--gold); font-weight: 600; white-space: nowrap; }
  .pk-price span { font-size: 1rem; color: var(--stone-night); font-weight: 500; }
  .pk-desc { font-size: 1.08rem; }
  .pk-choice { font-size: 1rem; color: var(--stone-night); }
  .pk-choice span { font-style: italic; color: var(--ivory-on-night); }
  .ev-info { display: grid; gap: var(--gutter); grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); margin-top: var(--s-8); }
  .ev-card { border: 1px solid rgba(184,154,102,.35); padding: var(--s-6) var(--s-5); display: grid; gap: var(--s-3); align-content: start; }
  .gold { color: var(--gold); }
  .ev-allergy { grid-column: 1 / -1; font-size: 1rem; text-align: center; }
  .ev-cta { display: grid; justify-items: center; text-align: center; gap: var(--s-6); margin-top: var(--s-9); }
  .ev-cta .double-rule { width: 100%; }
  .ev-cta em { color: var(--gold); }
</style>
